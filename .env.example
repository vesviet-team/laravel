# ============================================================
# Application
# ============================================================
APP_NAME="My Store"
APP_ENV=local
APP_KEY=
# [B-02] MUST be false in production — exposes stack traces to end users
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

# ============================================================
# Admin Panel Access — roles that may open /admin (Filament)
# Comma-separated. Empty or unset falls back to super_admin,panel_user.
# Provision admins after deploy: php artisan admin:grant ops@yourdomain.com
# ============================================================
AUTH_ADMIN_ROLES=super_admin,panel_user

# ============================================================
# Logging — [B-02] Use 'error' in production, not 'debug'
# ============================================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ============================================================
# Database — [B-03] Use MySQL in production, NOT sqlite
# ============================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mystore
DB_USERNAME=root
DB_PASSWORD=

# ============================================================
# Session — [I-06] SESSION_ENCRYPT must be true in production
# Set SESSION_DOMAIN=.yourdomain.com (leading dot) for wildcard multi-tenancy
# ============================================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# ============================================================
# Cache
# ============================================================
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ============================================================
# Mail — [I-07] Set to real SMTP provider in production
# ============================================================
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# ============================================================
# Goship Shipping API — [I-07] All keys required for shipping rates
# ============================================================
GOSHIP_BASE_URL=https://api.goship.io/api/v2
GOSHIP_TOKEN=
GOSHIP_WAREHOUSE_NAME="Tên Kho Hàng"
GOSHIP_WAREHOUSE_PHONE=0901234567
GOSHIP_WAREHOUSE_ADDRESS="Địa chỉ kho"
GOSHIP_WAREHOUSE_CITY_ID=
GOSHIP_WAREHOUSE_DISTRICT_ID=

# ============================================================
# Banking & VietQR Payments (config/services.php)
# ============================================================
BANK_CODE=MB
BANK_ACCOUNT_NO=0123456789
BANK_ACCOUNT_NAME="MYSTORE COMPANY"

# ============================================================
# AWS (optional — only if using S3 for media storage)
# ============================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
